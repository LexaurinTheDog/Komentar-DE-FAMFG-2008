    "findings": [
      {
        "id": "p425",
        "review": "Alle drei Absätze: konkrete Befristung, kürzere Spezialhöchstdauer, rechtzeitiger Verlängerungsbeschluss, Freilassung/Mitteilung und erneute Erstprüfung abgeglichen.",
        "corrected": false
      },
      {
        "id": "p426",
        "review": "Amtsaufhebung bei Wegfall, vorherige Behördenanhörung, Beteiligtenantrag/Beschluss und Unterschied zur ursprünglichen Rechtmäßigkeitskontrolle geprüft.",
        "corrected": false
      },
      {
        "id": "p427",
        "review": "Beide Eilkonstellationen, Sechswochenobergrenze und unverzügliche Nachholung geprüft; abweichende Tatbestände des Absatzes 3 gegenüber Absätzen 1/2 ausdrücklich präzisiert.",
        "corrected": true
      },
      {
        "id": "p428",
        "review": "Keine eigene Eingriffsbefugnis, unverzügliche Richterbefassung versus äußerste Folgetagesgrenze und gerichtliche Kontrolle der Verwaltungsmaßnahme geprüft.",
        "corrected": false
      },
      {
        "id": "p429",
        "review": "Behörde, Angehörigenkategorien einschließlich Zusammenleben/nicht dauernd getrennt, Beteiligung erster Instanz, Vertrauensperson/Pfleger und Einlegungsort abgeglichen.",
        "corrected": false
      },
      {
        "id": "p430",
        "review": "Ablehnung/Rücknahme plus fehlender begründeter Anlass kumulativ, notwendige Auslagen und richtige Körperschaft geprüft.",
        "corrected": false
      },
      {
        "id": "p431",
        "review": "Entsprechende §§308/311, Erforderlichkeit/Interessenabwägung und Dokumentation, Mitteilung an Einrichtungsleitung sowie redaktionelle §426-Verweisung geprüft.",
        "corrected": false
      },
      {
        "id": "p432",
        "review": "Gerichtliche Pflicht bei Anordnung und Verlängerung, alternative Empfänger, Unverzüglichkeit und fehlender Automatismus zur Beteiligtenstellung geprüft.",
        "corrected": false
      },
      {
        "id": "p433",
        "review": "Gesetzesvorbehalt des Aufgebots, bestimmter Rechtsnachteil und keine allgemeine Forderungsvernichtung geprüft.",
        "corrected": false
      },
      {
        "id": "p434",
        "review": "Antragserfordernis und alle drei Mindestinhalte; insbesondere offener Katalog und Abgrenzung zur Endentscheidung geprüft.",
        "corrected": false
      },
      {
        "id": "p435",
        "review": "Kumulative Grundbekanntmachung, elektronischer Aushangersatz und lediglich zusätzliche Publikation geprüft.",
        "corrected": false
      },
      {
        "id": "p436",
